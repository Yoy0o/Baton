# 复制为 .env 后按需修改。run_demo.py 启动时会读取 .env。

# ---- 产品名称（工作台标题、服务名都从这里读取）----
APP_NAME=Baton
APP_TAGLINE=多系统编排台

# ---- 模型（不填则进入“演示模式”：用内置脚本规划器跑通三个演示场景）----
# 任意 OpenAI 兼容的 Chat Completions 接口均可（需支持 tools / function calling）。
# 示例（按你的服务商替换）：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=90
# 流式输出（接口不支持时自动退回一次性返回）
LLM_STREAM=true
# 演示模式模拟逐字输出的间隔（秒），0 为不模拟
DEMO_STREAM_DELAY_S=0.012

# ---- Agent 服务 ----
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
# 浏览器访问 Agent 服务的地址（内嵌系统页面用它连接桥接中心、读取结果）
AGENT_PUBLIC_URL=http://localhost:8000
# 对话、结果、审计的存放目录；工作台前端构建产物目录（默认即为下面的值）
# AGENT_DATA_DIR=./data
# AGENT_WEB_DIR=./web/dist
AGENT_MAX_STEPS=12
AGENT_CONFIRM_TIMEOUT_S=600
AGENT_UI_CALL_TIMEOUT_S=20

# ---- 模拟业务系统地址（接入清单 manifest.yaml 中以 ${VAR:-默认值} 引用）----
FLEET_URL=http://localhost:8101
TMS_URL=http://localhost:8102
DISPATCH_URL=http://localhost:8103
